# Пример переменных окружения для Doneo.
# Скопируй в .env и заполни под свой SMS-провайдер.
# Файл .env добавлен в .gitignore — секреты не попадут в репозиторий.

# Порт API (по умолчанию 4000)
PORT=4000

# Базовый URL API на клиенте (по умолчанию /api)
VITE_API_URL=/api

# --- SMS-провайдер: console | twilio | smsru ---
# console — SMS пишется в лог сервера (для разработки, реально не отправляется)
SMS_PROVIDER=console

# Twilio (https://www.twilio.com/console)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=+15550000000

# SMS.ru (https://sms.ru/dashboard)
# SMSRU_API_ID=xxxxxxxx-xxxx-xxxx

# --- AI-советник: только ChatGPT, Grok или Gemini ---
# Достаточно одного ключа. Если ключей нет или нет интернета,
# Doneo показывает офлайн-советы (см. server/ai.js).
# OPENAI_API_KEY=sk-...            # ChatGPT      (gpt-4o-mini)
# XAI_API_KEY=xai-...              # Grok         (grok-2-latest)
# GEMINI_API_KEY=AIza...           # Gemini       (gemini-1.5-flash)

# Подписки: реальной оплаты нет, активация идёт в demo-режиме
# (server/billing.js). Для боевого запуска замените checkout на Stripe/Paddle.
DEMO_BILLING=true
